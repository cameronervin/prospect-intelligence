# Copy to .env.local for local overrides. Do not commit populated environment files.

# -------- PostgreSQL -------------------------
POSTGRES_DB=takehome
POSTGRES_USER=takehome
POSTGRES_PASSWORD=takehome
POSTGRES_PORT=5432
POSTGRES_RUNTIME_UID=70
POSTGRES_RUNTIME_GID=70

# -------- Application -------------------------
TAKEHOME_SERVICE_NAME=langchain-takehome-backend
TAKEHOME_ENVIRONMENT=development
TAKEHOME_LOG_LEVEL=INFO
TAKEHOME_LOG_JSON=false
TAKEHOME_DOCS_ENABLED=true
TAKEHOME_DEMO_AUTH_ENABLED=true
TAKEHOME_JWT_SIGNING_SECRET=local-demo-signing-key-at-least-32-bytes
TAKEHOME_RUNTIME_JEV_GUARDRAILS_ENABLED=false
TAKEHOME_ONLINE_QUALITY_ENABLED=false
TAKEHOME_ONLINE_QUALITY_SAMPLE_RATE=0.10
TAKEHOME_ONLINE_QUALITY_BATCH_SIZE=10
TAKEHOME_ONLINE_QUALITY_POLL_SECONDS=1
TAKEHOME_ONLINE_QUALITY_PUBLISH_TIMEOUT_SECONDS=75
TAKEHOME_LANGSMITH_ALERT_WEBHOOK_URL=https://alerts.example.invalid/langsmith

# -------- Database -------------------------
TAKEHOME_DATABASE_CONNECT_TIMEOUT_SECONDS=5
TAKEHOME_DATABASE_STATEMENT_TIMEOUT_MS=5000

# -------- Ports -------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# -------- Models -------------------------
TAKEHOME_MODEL_PROVIDER=openai
TAKEHOME_ORCHESTRATOR_MODEL=gpt-5.6-sol
TAKEHOME_SUBAGENT_MODEL=gpt-5.6-luna
# HTTPS OpenAI endpoint for this project's regional API key.
TAKEHOME_OPENAI_BASE_URL=https://us.api.openai.com/v1
TAKEHOME_ORCHESTRATOR_REASONING_EFFORT=medium
TAKEHOME_MODEL_REQUEST_TIMEOUT_SECONDS=60
TAKEHOME_MODEL_RETRY_ATTEMPTS=2

# -------- External Sources -------------------------
TAKEHOME_EXTERNAL_LIVE_ENABLED=false
TAKEHOME_EXTERNAL_REQUEST_TIMEOUT_SECONDS=10
TAKEHOME_EXTERNAL_RETRY_ATTEMPTS=2
TAKEHOME_SEC_APP_NAME=freight-prospect-takehome
TAKEHOME_SEC_CONTACT_EMAIL=contact@example.invalid

# -------- LangSmith -------------------------
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=langchain-takehome
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
LANGSMITH_HIDE_METADATA=true
LANGSMITH_API_KEY=your-langsmith-api-key

# -------- API Keys -------------------------
OPENAI_API_KEY=your-openai-api-key
TYPESAFE_API_KEY=your-typesafe-api-key
TAVILY_API_KEY=your-tavily-api-key
FMCSA_WEB_KEY=your-fmcsa-api-key
