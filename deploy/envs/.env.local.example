# Copy to .env.local for local overrides. Do not commit populated environment files.

POSTGRES_DB=takehome
POSTGRES_USER=takehome
POSTGRES_PASSWORD=takehome
POSTGRES_PORT=5432
POSTGRES_RUNTIME_UID=70
POSTGRES_RUNTIME_GID=70

TAKEHOME_ENVIRONMENT=development
TAKEHOME_LOG_LEVEL=INFO
TAKEHOME_LOG_JSON=false
TAKEHOME_DOCS_ENABLED=true
BACKEND_PORT=8000
FRONTEND_PORT=3000

LANGSMITH_TRACING=false
LANGSMITH_PROJECT=langchain-takehome-local
# LANGSMITH_API_KEY is intentionally supplied only through a shell or secret manager.
