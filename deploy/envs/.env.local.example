# Copy to .env.local for local overrides. Do not commit populated environment files.

# -------- PostgreSQL -------------------------
POSTGRES_DB=takehome
POSTGRES_USER=takehome
POSTGRES_PASSWORD=takehome
POSTGRES_PORT=5432
POSTGRES_RUNTIME_UID=70
POSTGRES_RUNTIME_GID=70

# -------- Application -------------------------
TAKEHOME_ENVIRONMENT=development
TAKEHOME_LOG_LEVEL=INFO
TAKEHOME_LOG_JSON=false
TAKEHOME_DOCS_ENABLED=true

# -------- Ports -------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# -------- Models -------------------------
TAKEHOME_MODEL_PROVIDER=openai
TAKEHOME_ORCHESTRATOR_MODEL=gpt-5.6-sol
TAKEHOME_SUBAGENT_MODEL=gpt-5.6-luna
# HTTPS OpenAI endpoint for this project's regional API key.
TAKEHOME_OPENAI_BASE_URL=https://us.api.openai.com/v1
TAKEHOME_ORCHESTRATOR_REASONING_EFFORT=medium

# -------- External Sources -------------------------
TAKEHOME_EXTERNAL_LIVE_ENABLED=false
TAKEHOME_SEC_APP_NAME=freight-prospect-takehome
TAKEHOME_SEC_CONTACT_EMAIL=contact@example.invalid

# -------- LangSmith -------------------------
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=langchain-takehome
LANGSMITH_API_KEY=your-langsmith-api-key

# -------- API Keys -------------------------
OPENAI_API_KEY=your-openai-api-key
TYPESAFE_API_KEY=your-typesafe-api-key
TAVILY_API_KEY=your-tavily-api-key
FMCSA_WEB_KEY=your-fmcsa-api-key
