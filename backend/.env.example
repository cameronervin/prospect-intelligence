# -------- Application -------------------------
TAKEHOME_ENVIRONMENT=development
TAKEHOME_LOG_LEVEL=INFO
TAKEHOME_LOG_JSON=false
TAKEHOME_DOCS_ENABLED=true

# -------- Database -------------------------
TAKEHOME_DATABASE_URL=postgresql+psycopg://takehome:takehome@localhost:5432/takehome
TAKEHOME_DATABASE_CONNECT_TIMEOUT_SECONDS=5
TAKEHOME_DATABASE_STATEMENT_TIMEOUT_MS=5000

# -------- Models -------------------------
TAKEHOME_MODEL_PROVIDER=openai
TAKEHOME_ORCHESTRATOR_MODEL=gpt-6-sol
TAKEHOME_SUBAGENT_MODEL=gpt-6-luna
TAKEHOME_ORCHESTRATOR_REASONING_EFFORT=medium

# -------- External Sources -------------------------
TAKEHOME_EXTERNAL_LIVE_ENABLED=false
TAKEHOME_EXTERNAL_REQUEST_TIMEOUT_SECONDS=10
TAKEHOME_EXTERNAL_RETRY_ATTEMPTS=2
TAKEHOME_SEC_USER_AGENT=freight-prospect-takehome contact@example.invalid

# -------- LangSmith -------------------------
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=langchain-takehome
LANGSMITH_API_KEY=your-langsmith-api-key

# -------- API Keys -------------------------
OPENAI_API_KEY=your-openai-api-key
TYPESAFE_API_KEY=your-typesafe-api-key
TAVILY_API_KEY=your-tavily-api-key
FMCSA_WEB_KEY=your-fmcsa-api-key
