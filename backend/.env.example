TAKEHOME_ENVIRONMENT=development
TAKEHOME_LOG_LEVEL=INFO
TAKEHOME_LOG_JSON=false
TAKEHOME_DOCS_ENABLED=true
TAKEHOME_DATABASE_URL=postgresql+psycopg://takehome:takehome@localhost:5432/takehome
TAKEHOME_DATABASE_CONNECT_TIMEOUT_SECONDS=5
TAKEHOME_DATABASE_STATEMENT_TIMEOUT_MS=5000
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=langchain-takehome-development
# LANGSMITH_API_KEY is intentionally omitted. Supply it through your shell or secret manager.

